CREWAI_STORAGE_DIR="LSM_ReproChecker/src/knowledge_openai"

# Telemetry's OTLP exporter hangs for minutes on this network; disabled to avoid stalled runs.
# (config.py also sets these via os.environ before importing crewai, as a guarantee independent
# of whether/when .env gets loaded.)
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

GEMINI_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=