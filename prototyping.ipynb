                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>                                                                                                                 <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>  <span style=\"color: #008000; text-decoration-color: #008000\">values of two landslides, with low and high local-incident angles were analysed.</span>                               <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>                                                                                                                 <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>  <span style=\"color: #008000; text-decoration-color: #008000\">5. Results</span>                                                                                                     <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
