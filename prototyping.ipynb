                    "data": {
                        "text/plain": [
                            "[MethodEntry(name='Manual digitisation of landslides from Sentinel-2 Bi-Temporal (S2-BT) dNDVI composite in SNAP', method_type='MANUAL', summary='Preliminary landslide mapping was conducted using the conventional S2-BT approach. Pre- and post-event Level 2A Sentinel-2 tiles were processed in SNAP 7.0 software (cropped, collocated, and band-math used to calculate dNDVI = (B8R−B4R)/(B8R+B4R) − (B8S−B4S)/(B8S+B4S)). Polygons delimiting assumed landslides, typically represented by dark elongated clusters of pixels, were then drawn manually in SNAP. This preliminary mapping was completed within a week of the landslide occurrences and took approximately three hours; it was later verified and updated through field visits, a helicopter flight, and comparison with a detailed field map.', code_status='N/A', code_link=None, reused_citation=None),\n",
                            " MethodEntry(name='Sentinel-2 Multi-Temporal (S2-MT) dNDVI composite generation in Google Earth Engine', method_type='CUSTOM_CODE', summary=\"In GEE, separate pre- and post-event Sentinel-2 level 2A image collections were produced by filtering the entire collection by location and date. NDVI bands were added to all images, then 'greenest-pixel' pre- and post-event composite images were created by taking the maximum NDVI value per pixel using the quality mosaic function. A difference image (dNDVI) was produced by subtracting the pre-event composite from the post-event composite. This composite was then used for visual/manual landslide detection and comparison against the S2-BT baseline inventory.\", code_status='FOUND', code_link='https://github.com/erin-ntnu/Change-detection-images-GEE', reused_citation=None),\n",
                            " MethodEntry(name='Sentinel-1 Bi-Temporal (S1-BT) enriched RGB backscatter change-detection composite', method_type='REUSED', summary='Pre- and post-event Sentinel-1 SLC scenes (IW mode, VV/VH) were downloaded from COAH, geocoded, orbit-corrected, noise-removed, multi-looked, and geocoded with a 10 m DTM to produce radar backscatter images. To facilitate visual interpretation, multi-temporal change detection was applied using enriched colour composites (R,G,B) = (pre, post, pre), stretched from [−35,10] dB to [−25,5] dB, following an approach originally developed for snow-avalanche detection. The best of three composites (based on different post-event dates) was manually selected for further (manual) landslide visibility analysis.', code_status='N/A', code_link=None, reused_citation='Approach for enriched RGB backscatter composites developed for snow-avalanche detection (references [43,44] in the paper)'),\n",
                            " MethodEntry(name='Sentinel-1 Multi-Temporal (S1-MT) RGB backscatter composite generation in Google Earth Engine', method_type='CUSTOM_CODE', summary='Using GEE, pre-processed Sentinel-1 GRD scenes (calibrated and ortho-corrected via the Sentinel-1 Toolbox) were filtered into separate pre- and post-event collections by location, date, polarisation (VV, VH), acquisition geometry (ascending/descending mean combined via median), and acquisition mode (IW). A topographic correction function was applied using a 10 m DTM uploaded as a GEE asset. The two collections were reduced to single mean images, and RGB composites were created for VV and VH polarisations (pre-event in red/green channels, post-event in blue channel), displayed with a stretch of [−21,0.5] and gamma 0.65, for manual/visual landslide detection and comparison.', code_status='FOUND', code_link='https://github.com/erin-ntnu/Change-detection-images-GEE', reused_citation=None),\n",
                            " MethodEntry(name='Detailed manual field mapping and verification of landslide inventory (release/transport/deposition zones)', method_type='MANUAL', summary='A detailed landslide map was produced by co-author D. Rüther, initially through visual comparison of pre- and post-event Sentinel-2 images, then refined through extensive field investigations (August/September 2019, May/June/August 2020) and drone orthophotos. This inventory divides landslides into release, transport, and deposition zones and has much higher resolution than the S2-BT outlines; it was used together with helicopter-flight observations and field visits to verify and update the preliminary S2-BT inventory.', code_status='N/A', code_link=None, reused_citation=None),\n",
                            " MethodEntry(name='Three-tier landslide visibility classification (Set 1/2/3) for comparing manual mapping approaches', method_type='REUSED', summary='To compare the four manual mapping approaches (S2-BT, S2-MT, S1-BT, S1-MT), the verified S2-BT inventory was used as baseline. The other composite images were visually inspected, then systematically searched for traces of previously known landslides and classified using a three-set classification system: Set 1 (not visible in the SAR-RGB image), Set 2 (hardly visible, recognisable only with prior location knowledge), and Set 3 (clearly visible). This classification system was adopted from a prior publication.', code_status='N/A', code_link=None, reused_citation='Classification system used by reference [46] in the paper')]"
