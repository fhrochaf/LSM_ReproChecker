                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>                                                                                                                 <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>  <span style=\"color: #008000; text-decoration-color: #008000\">approaches, improving landslide visibility without compromising spatial resolution. Our results</span>                <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
