                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>                                                                                                                 <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
                            "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>  <span style=\"color: #008000; text-decoration-color: #008000\">Remote Sens. 2022, 14, 2301</span>                                                                                    <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
