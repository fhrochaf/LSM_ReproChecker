                            "\u001b[32m│\u001b[0m                                                                                                                 \u001b[32m│\u001b[0m\n",
                            "\u001b[32m│\u001b[0m  \u001b[32mthe following equation:\u001b[0m                                                                                        \u001b[32m│\u001b[0m\n",
                            "\u001b[32m│\u001b[0m                                                                                                                 \u001b[32m│\u001b[0m\n",
